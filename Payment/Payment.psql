CREATE TABLE payment_methods (
    method_id INTEGER GENERATED BY DEFAULT AS IDENTITY,
    label VARCHAR(50) NOT NULL,

    CONSTRAINT payment_methods_pkey PRIMARY KEY (method_id),
    CONSTRAINT payment_methods_label_key UNIQUE (label)
);
CREATE INDEX IF NOT EXISTS idx_payments_method_id
    ON public.payments (method_id);

CREATE TABLE payments (
    payment_id INTEGER GENERATED BY DEFAULT AS IDENTITY,
    order_id INTEGER NOT NULL,
    method_id INTEGER NOT NULL,
    idempotency_key VARCHAR(64) NOT NULL,
    amount NUMERIC(10, 2) NOT NULL,
    amount_collected NUMERIC(10, 2),
    is_flagged BOOLEAN NOT NULL DEFAULT FALSE,
    failure_reason TEXT,
    status VARCHAR(20) NOT NULL DEFAULT 'pending',
    paid_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    gateway_reference VARCHAR(255),

    CONSTRAINT payments_pkey PRIMARY KEY (payment_id),
    CONSTRAINT payments_order_id_key UNIQUE (order_id),
    CONSTRAINT payments_idempotency_key_key UNIQUE (idempotency_key),


    CONSTRAINT payments_order_id_fkey
        FOREIGN KEY (order_id)
        REFERENCES public.orders (order_id),

    CONSTRAINT payments_method_id_fkey
        FOREIGN KEY (method_id)
        REFERENCES public.payment_methods (method_id),

    CONSTRAINT payments_status_check
        CHECK (status IN ('pending', 'paid', 'collected', 'failed'))
);
CREATE INDEX IF NOT EXISTS idx_payments_status
    ON public.payments (status);