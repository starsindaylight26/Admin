CREATE TABLE users (
    user_id        UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email          VARCHAR(255) NOT NULL UNIQUE,
    phone          VARCHAR(20)  UNIQUE,
    password_hash  VARCHAR(255) NOT NULL,
    role           VARCHAR(20)  NOT NULL
                   CHECK (role IN ('resident','merchant','rider','admin')),
    status         VARCHAR(20)  NOT NULL DEFAULT 'pending'
                   CHECK (status IN ('pending','active','rejected','suspended')),
    created_at     TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
    updated_at     TIMESTAMPTZ  NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_users_role_status ON users (role, status);

-- ---------- 2. resident_profiles ----------
CREATE TABLE resident_profiles (
    resident_id     UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id         UUID NOT NULL UNIQUE REFERENCES users(user_id) ON DELETE CASCADE,
    first_name      VARCHAR(100) NOT NULL,
    last_name       VARCHAR(100) NOT NULL,
    birth_date      DATE,
    contact_number  VARCHAR(20),
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ---------- 3. barangays ----------
CREATE TABLE barangays (
    barangay_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name         VARCHAR(100) NOT NULL,
    city         VARCHAR(100) NOT NULL,
    province     VARCHAR(100),
    is_active    BOOLEAN NOT NULL DEFAULT TRUE,
    UNIQUE (name, city)
);

-- ---------- 4. addresses ----------
CREATE TABLE addresses (
    address_id      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id         UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    barangay_id     UUID NOT NULL REFERENCES barangays(barangay_id),
    label           VARCHAR(50),
    street_address  VARCHAR(255) NOT NULL,
    landmark        VARCHAR(255),
    latitude        NUMERIC(9,6),
    longitude       NUMERIC(9,6),
    is_default      BOOLEAN NOT NULL DEFAULT FALSE,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_addresses_user ON addresses (user_id);
CREATE INDEX idx_addresses_barangay ON addresses (barangay_id);

-- ---------- 5. merchant_profiles ----------
CREATE TABLE merchant_profiles (
    merchant_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id           UUID NOT NULL UNIQUE REFERENCES users(user_id) ON DELETE CASCADE,
    pharmacy_name     VARCHAR(150) NOT NULL,
    license_number    VARCHAR(100),
    address_id        UUID REFERENCES addresses(address_id),
    status            VARCHAR(20) NOT NULL DEFAULT 'pending'
                      CHECK (status IN ('pending','approved','rejected','suspended')),
    rejection_reason  TEXT,
    reviewed_by       UUID REFERENCES users(user_id),
    reviewed_at       TIMESTAMPTZ,
    created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_merchant_status ON merchant_profiles (status);

-- ---------- 6. merchant_hours ----------
CREATE TABLE merchant_hours (
    hour_id      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    merchant_id  UUID NOT NULL REFERENCES merchant_profiles(merchant_id) ON DELETE CASCADE,
    day_of_week  SMALLINT NOT NULL CHECK (day_of_week BETWEEN 0 AND 6),
    open_time    TIME,
    close_time   TIME,
    is_closed    BOOLEAN NOT NULL DEFAULT FALSE,
    UNIQUE (merchant_id, day_of_week)
);

-- ---------- 7. product_categories ----------
CREATE TABLE product_categories (
    category_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name         VARCHAR(100) NOT NULL UNIQUE,
    description  TEXT,
    is_active    BOOLEAN NOT NULL DEFAULT TRUE
);

-- ---------- 8. products ----------
CREATE TABLE products (
    product_id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    merchant_id           UUID NOT NULL REFERENCES merchant_profiles(merchant_id) ON DELETE CASCADE,
    category_id           UUID REFERENCES product_categories(category_id),
    name                  VARCHAR(200) NOT NULL,
    generic_name          VARCHAR(200),
    description           TEXT,
    price                 NUMERIC(10,2) NOT NULL CHECK (price >= 0),
    requires_prescription BOOLEAN NOT NULL DEFAULT FALSE,
    image_url             VARCHAR(500),
    is_active             BOOLEAN NOT NULL DEFAULT TRUE,
    created_at            TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at            TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_products_merchant ON products (merchant_id);
CREATE INDEX idx_products_category ON products (category_id);
CREATE INDEX idx_products_name ON products (LOWER(name));

-- ---------- 9. inventory ----------
CREATE TABLE inventory (
    inventory_id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    product_id           UUID NOT NULL UNIQUE REFERENCES products(product_id) ON DELETE CASCADE,
    quantity             INTEGER NOT NULL DEFAULT 0 CHECK (quantity >= 0),
    low_stock_threshold  INTEGER NOT NULL DEFAULT 10 CHECK (low_stock_threshold >= 0),
    updated_at           TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ---------- 10. carts ----------
CREATE TABLE carts (
    cart_id      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id      UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    merchant_id  UUID NOT NULL REFERENCES merchant_profiles(merchant_id),
    status       VARCHAR(20) NOT NULL DEFAULT 'active'
                 CHECK (status IN ('active','checked_out','abandoned')),
    created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
-- Only one active cart per resident per pharmacy
CREATE UNIQUE INDEX uq_active_cart
    ON carts (user_id, merchant_id) WHERE status = 'active';

-- ---------- 11. cart_items ----------
CREATE TABLE cart_items (
    cart_item_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    cart_id       UUID NOT NULL REFERENCES carts(cart_id) ON DELETE CASCADE,
    product_id    UUID NOT NULL REFERENCES products(product_id),
    quantity      INTEGER NOT NULL CHECK (quantity > 0),
    UNIQUE (cart_id, product_id)
);

-- ---------- 12. orders ----------
CREATE TABLE orders (
    order_id             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id              UUID NOT NULL REFERENCES users(user_id),
    merchant_id          UUID NOT NULL REFERENCES merchant_profiles(merchant_id),
    delivery_address_id  UUID NOT NULL REFERENCES addresses(address_id),
    status               VARCHAR(30) NOT NULL DEFAULT 'pending'
                         CHECK (status IN ('pending','accepted','rejected','preparing',
                                           'ready_for_pickup','out_for_delivery',
                                           'delivered','cancelled')),
    subtotal             NUMERIC(10,2) NOT NULL CHECK (subtotal >= 0),
    delivery_fee         NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (delivery_fee >= 0),
    total_amount         NUMERIC(10,2) NOT NULL CHECK (total_amount >= 0),
    payment_method       VARCHAR(20) NOT NULL DEFAULT 'COD' CHECK (payment_method IN ('COD')),
    notes                TEXT,
    created_at           TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at           TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_orders_user ON orders (user_id, created_at DESC);
CREATE INDEX idx_orders_merchant ON orders (merchant_id, status);
CREATE INDEX idx_orders_status ON orders (status, created_at DESC);

-- ---------- 13. order_items ----------
CREATE TABLE order_items (
    order_item_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id       UUID NOT NULL REFERENCES orders(order_id) ON DELETE CASCADE,
    product_id     UUID NOT NULL REFERENCES products(product_id),
    quantity       INTEGER NOT NULL CHECK (quantity > 0),
    unit_price     NUMERIC(10,2) NOT NULL CHECK (unit_price >= 0)  -- historical price
);
CREATE INDEX idx_order_items_order ON order_items (order_id);

-- ---------- 14. order_status_history ----------
CREATE TABLE order_status_history (
    history_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id    UUID NOT NULL REFERENCES orders(order_id) ON DELETE CASCADE,
    status      VARCHAR(30) NOT NULL,
    changed_by  UUID REFERENCES users(user_id),
    note        TEXT,
    created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_order_history_order ON order_status_history (order_id, created_at);

-- ---------- 15. prescriptions ----------
CREATE TABLE prescriptions (
    prescription_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id         UUID NOT NULL REFERENCES orders(order_id) ON DELETE CASCADE,
    user_id          UUID NOT NULL REFERENCES users(user_id),
    file_path        VARCHAR(500) NOT NULL,   -- store outside public web root
    status           VARCHAR(20) NOT NULL DEFAULT 'pending'
                     CHECK (status IN ('pending','approved','rejected')),
    reviewed_by      UUID REFERENCES users(user_id),
    reviewed_at      TIMESTAMPTZ,
    remarks          TEXT,
    created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_prescriptions_order ON prescriptions (order_id);

-- ---------- 16. payments ----------
CREATE TABLE payments (
    payment_id        UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id          UUID NOT NULL UNIQUE REFERENCES orders(order_id) ON DELETE CASCADE,
    method            VARCHAR(20) NOT NULL DEFAULT 'COD',
    amount_due        NUMERIC(10,2) NOT NULL CHECK (amount_due >= 0),
    amount_collected  NUMERIC(10,2) CHECK (amount_collected >= 0),
    status            VARCHAR(20) NOT NULL DEFAULT 'pending'
                      CHECK (status IN ('pending','collected','discrepancy','remitted')),
    collected_by      UUID REFERENCES users(user_id),
    collected_at      TIMESTAMPTZ,
    remarks           TEXT,
    created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_payments_status ON payments (status);

-- ---------- 17. rider_profiles ----------
CREATE TABLE rider_profiles (
    rider_id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id          UUID NOT NULL UNIQUE REFERENCES users(user_id) ON DELETE CASCADE,
    vehicle_type     VARCHAR(50) NOT NULL,
    plate_number     VARCHAR(20),
    license_number   VARCHAR(100),
    approval_status  VARCHAR(20) NOT NULL DEFAULT 'pending'
                     CHECK (approval_status IN ('pending','approved','rejected','suspended')),
    is_available     BOOLEAN NOT NULL DEFAULT FALSE,
    reviewed_by      UUID REFERENCES users(user_id),
    reviewed_at      TIMESTAMPTZ,
    created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ---------- 18. deliveries ----------
CREATE TABLE deliveries (
    delivery_id    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id       UUID NOT NULL UNIQUE REFERENCES orders(order_id) ON DELETE CASCADE,
    rider_id       UUID REFERENCES rider_profiles(rider_id),
    status         VARCHAR(30) NOT NULL DEFAULT 'searching_rider'
                   CHECK (status IN ('searching_rider','assigned','picked_up',
                                     'on_the_way','delivered','failed','cancelled')),
    assigned_at    TIMESTAMPTZ,
    picked_up_at   TIMESTAMPTZ,
    delivered_at   TIMESTAMPTZ,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_deliveries_rider ON deliveries (rider_id, status);

-- ---------- 19. delivery_offers ----------
CREATE TABLE delivery_offers (
    offer_id      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    delivery_id   UUID NOT NULL REFERENCES deliveries(delivery_id) ON DELETE CASCADE,
    rider_id      UUID NOT NULL REFERENCES rider_profiles(rider_id),
    status        VARCHAR(20) NOT NULL DEFAULT 'pending'
                  CHECK (status IN ('pending','accepted','declined','expired')),
    offered_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    responded_at  TIMESTAMPTZ,
    UNIQUE (delivery_id, rider_id)    -- recommended constraint from the spec
);

-- ---------- 20. delivery_status_history ----------
CREATE TABLE delivery_status_history (
    history_id   UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    delivery_id  UUID NOT NULL REFERENCES deliveries(delivery_id) ON DELETE CASCADE,
    status       VARCHAR(30) NOT NULL,
    changed_by   UUID REFERENCES users(user_id),
    note         TEXT,
    created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_delivery_history ON delivery_status_history (delivery_id, created_at);

-- ---------- 21. rider_locations ----------
CREATE TABLE rider_locations (
    location_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rider_id     UUID NOT NULL REFERENCES rider_profiles(rider_id) ON DELETE CASCADE,
    delivery_id  UUID REFERENCES deliveries(delivery_id) ON DELETE SET NULL,
    latitude     NUMERIC(9,6) NOT NULL,
    longitude    NUMERIC(9,6) NOT NULL,
    recorded_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_rider_locations ON rider_locations (rider_id, recorded_at DESC);

-- ---------- 22. rider_earnings ----------
CREATE TABLE rider_earnings (
    earning_id     UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rider_id       UUID NOT NULL REFERENCES rider_profiles(rider_id),
    delivery_id    UUID NOT NULL UNIQUE REFERENCES deliveries(delivery_id),
    amount         NUMERIC(10,2) NOT NULL CHECK (amount >= 0),
    payout_status  VARCHAR(20) NOT NULL DEFAULT 'pending'
                   CHECK (payout_status IN ('pending','paid')),
    paid_at        TIMESTAMPTZ,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ---------- 23. rider_ratings ----------
CREATE TABLE rider_ratings (
    rating_id    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    delivery_id  UUID NOT NULL UNIQUE REFERENCES deliveries(delivery_id) ON DELETE CASCADE,
    rider_id     UUID NOT NULL REFERENCES rider_profiles(rider_id),
    user_id      UUID NOT NULL REFERENCES users(user_id),
    rating       SMALLINT NOT NULL CHECK (rating BETWEEN 1 AND 5),
    comment      TEXT,
    created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ---------- 24. medicine_searches ----------
CREATE TABLE medicine_searches (
    search_id      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id        UUID REFERENCES users(user_id) ON DELETE SET NULL,
    search_term    VARCHAR(200) NOT NULL,
    results_count  INTEGER NOT NULL DEFAULT 0,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_searches_term ON medicine_searches (LOWER(search_term));

-- ---------- 25. pharmacy_reviews ----------
CREATE TABLE pharmacy_reviews (
    review_id    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    merchant_id  UUID NOT NULL REFERENCES merchant_profiles(merchant_id) ON DELETE CASCADE,
    user_id      UUID NOT NULL REFERENCES users(user_id),
    order_id     UUID REFERENCES orders(order_id) ON DELETE SET NULL,
    rating       SMALLINT NOT NULL CHECK (rating BETWEEN 1 AND 5),
    comment      TEXT,
    is_hidden    BOOLEAN NOT NULL DEFAULT FALSE,   -- admin moderation
    created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_reviews_merchant ON pharmacy_reviews (merchant_id);

-- ---------- 26. problem_reports ----------
CREATE TABLE problem_reports (
    report_id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id           UUID NOT NULL REFERENCES users(user_id),
    order_id          UUID REFERENCES orders(order_id) ON DELETE SET NULL,
    category          VARCHAR(50) NOT NULL,
    description       TEXT NOT NULL,
    status            VARCHAR(20) NOT NULL DEFAULT 'open'
                      CHECK (status IN ('open','in_review','resolved','dismissed')),
    resolved_by       UUID REFERENCES users(user_id),
    resolved_at       TIMESTAMPTZ,
    resolution_notes  TEXT,
    created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_reports_status ON problem_reports (status, created_at DESC);

-- ---------- 27. emergency_alerts ----------
CREATE TABLE emergency_alerts (
    alert_id    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id     UUID NOT NULL REFERENCES users(user_id),
    address_id  UUID REFERENCES addresses(address_id),
    latitude    NUMERIC(9,6),
    longitude   NUMERIC(9,6),
    message     TEXT,
    status      VARCHAR(20) NOT NULL DEFAULT 'active'
                CHECK (status IN ('active','acknowledged','resolved')),
    created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_alerts_status ON emergency_alerts (status, created_at DESC);

-- ---------- 28. notifications ----------
CREATE TABLE notifications (
    notification_id  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id          UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    title            VARCHAR(150) NOT NULL,
    message          TEXT NOT NULL,
    type             VARCHAR(50),
    is_read          BOOLEAN NOT NULL DEFAULT FALSE,
    created_by       UUID REFERENCES users(user_id),
    created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX idx_notifications_user ON notifications (user_id, is_read, created_at DESC);

-- ------------------------------------------------------------
-- Auto-update updated_at on tables that have it
-- ------------------------------------------------------------
CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DO $$
DECLARE t TEXT;
BEGIN
    FOREACH t IN ARRAY ARRAY['users','resident_profiles','merchant_profiles','products',
                             'inventory','carts','orders','rider_profiles']
    LOOP
        EXECUTE format(
            'CREATE TRIGGER trg_%1$s_updated_at BEFORE UPDATE ON %1$I
             FOR EACH ROW EXECUTE FUNCTION set_updated_at()', t);
    END LOOP;
END $$;

-- ------------------------------------------------------------
-- Example: dashboard totals computed from real records
-- (no separate stats table, per the admin instructions)
-- ------------------------------------------------------------
CREATE OR REPLACE VIEW v_admin_dashboard AS
SELECT
    (SELECT COUNT(*) FROM users WHERE role = 'resident')                         AS total_residents,
    (SELECT COUNT(*) FROM merchant_profiles WHERE status = 'approved')           AS approved_pharmacies,
    (SELECT COUNT(*) FROM merchant_profiles WHERE status = 'pending')            AS pending_pharmacies,
    (SELECT COUNT(*) FROM rider_profiles WHERE approval_status = 'approved')     AS approved_riders,
    (SELECT COUNT(*) FROM rider_profiles WHERE approval_status = 'pending')      AS pending_riders,
    (SELECT COUNT(*) FROM orders)                                                AS total_orders,
    (SELECT COUNT(*) FROM orders WHERE status = 'delivered')                     AS delivered_orders,
    (SELECT COUNT(*) FROM problem_reports WHERE status IN ('open','in_review'))  AS open_reports,
    (SELECT COUNT(*) FROM emergency_alerts WHERE status = 'active')              AS active_alerts,
    (SELECT COUNT(*) FROM inventory WHERE quantity <= low_stock_threshold)       AS low_stock_items;
